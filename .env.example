# comfyui-danbooru-pack environment variables
# Copy this file to `.env` and fill in the values you need. Everything is
# optional: leave it blank to connect to Danbooru directly.

# --- Webshare proxy (DanbooruPack/Danbooru) -----------------------------------
# Optional rotating proxy for the Danbooru nodes (to dodge rate limits / IP
# bans). Both username and password must be set for the proxy to be used.
# SERVER defaults to the Webshare rotating endpoint.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# WEBSHARE_PROXY_SERVER=http://p.webshare.io:80
